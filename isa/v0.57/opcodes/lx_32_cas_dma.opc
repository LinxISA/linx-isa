# LinxISA v0.57 CAS and DMA extensions to v0.56 base opcodes
# These instructions extend the atomic operation group

CASB [{"asm":"casb<.{aq, rl, f, aqrl, aqf, rlf, aqrlf}> [SrcL], SrcR, {t, u, Rd}, ->{t, u, Rd}","group":"Atomic Operation","length_bits":32,"note":"RegDst serves as both input (swap value) and output (old value)"}] : 31..28=4'b0000 27=far 26=aq 25=rl 24..20=SrcR 19..15=SrcL 14..12=3'b111 11..7=RegDst 6..4=3'b000 3..1=3'b101 0=1 ; RegDst SrcL SrcR aq far rl ; -
CASH [{"asm":"cash<.{aq, rl, f, aqrl, aqf, rlf, aqrlf}> [SrcL], SrcR, {t, u, Rd}, ->{t, u, Rd}","group":"Atomic Operation","length_bits":32,"note":"RegDst serves as both input (swap value) and output (old value)"}] : 31..28=4'b0001 27=far 26=aq 25=rl 24..20=SrcR 19..15=SrcL 14..12=3'b111 11..7=RegDst 6..4=3'b000 3..1=3'b101 0=1 ; RegDst SrcL SrcR aq far rl ; -
CASW [{"asm":"casw<.{aq, rl, f, aqrl, aqf, rlf, aqrlf}> [SrcL], SrcR, {t, u, Rd}, ->{t, u, Rd}","group":"Atomic Operation","length_bits":32,"note":"RegDst serves as both input (swap value) and output (old value)"}] : 31..28=4'b0010 27=far 26=aq 25=rl 24..20=SrcR 19..15=SrcL 14..12=3'b111 11..7=RegDst 6..4=3'b000 3..1=3'b101 0=1 ; RegDst SrcL SrcR aq far rl ; -
CASD [{"asm":"casd<.{aq, rl, f, aqrl, aqf, rlf, aqrlf}> [SrcL], SrcR, {t, u, Rd}, ->{t, u, Rd}","group":"Atomic Operation","length_bits":32,"note":"RegDst serves as both input (swap value) and output (old value)"}] : 31..28=4'b0011 27=far 26=aq 25=rl 24..20=SrcR 19..15=SrcL 14..12=3'b111 11..7=RegDst 6..4=3'b000 3..1=3'b101 0=1 ; RegDst SrcL SrcR aq far rl ; -
DMA [{"asm":"dma SrcL, SrcR","group":"DMA Operation","length_bits":32,"note":"DMA placeholder - only uses SrcL and SrcR"}] : 31..28=4'b0000 27=0 26=0 25=0 24..20=SrcR 19..15=SrcL 14..12=3'b000 11..7=5'b0_0000 6..4=3'b001 3..1=3'b101 0=1 ; SrcL SrcR ; -
