# Canonical LinxISA v0.58 opcode source (consumed by tools/isa/build_golden.py)
#
# Format:
#   MNEMONIC [<json meta>] : <bit-assignments> [| <bit-assignments>] ; <operands> ; <constraints>
#
# Notes:
#   - If MNEMONIC contains spaces, it is written as a JSON string literal.
#   - Meta is a JSON object containing at least: {asm, group, length_bits}.
#   - Constraints apply to encoding part 0 and are written as tokens like Field!=0.

C.BSTART.VPAR [{"asm":"C.BSTART.VPAR FALL","group":"C.BSTART","length_bits":16}] : 15..14=2'b10 13..11=3'b001 10..6=5'b0_0011 5..4=2'b00 3..1=3'b000 0=0 ;  ; -
C.BSTART.VSEQ [{"asm":"C.BSTART.VSEQ FALL","group":"C.BSTART","length_bits":16}] : 15..14=2'b11 13..11=3'b001 10..6=5'b0_0011 5..4=2'b00 3..1=3'b000 0=0 ;  ; -

C.BSTART.MPAR [{"asm":"C.BSTART.MPAR FALL","group":"C.BSTART","length_bits":16,"note":"Closes the current bundle, initializes the next bundle descriptor, and selects its transfer and execution kind.","pto_source_constraints":[]}] : 15..0=16'b0000100011000000 ;  ; -
C.BSTART.MSEQ [{"asm":"C.BSTART.MSEQ FALL","group":"C.BSTART","length_bits":16,"note":"Closes the current bundle, initializes the next bundle descriptor, and selects its transfer and execution kind.","pto_source_constraints":[]}] : 15..0=16'b0100100011000000 ;  ; -

# PTO ISA 0.58.1 canonical scalar and command forms
C.ADD [{"asm":"c.add srcL, srcR, ->t","group":"ALU","length_bits":16,"note":"C.ADD snapshots two complete Reg5 sources, adds SrcL and SrcR, and pushes the wrapping XLEN result to T.","pto_source_constraints":[]}] : 15..11=SrcR 10..6=SrcL 5..0=6'b001000 ; SrcL SrcR ; -
C.ADDI [{"asm":"c.addi srcL, simm, ->t","group":"ALU","length_bits":16,"note":"C.ADDI snapshots one complete Reg5 source, sign-extends simm5, adds modulo 2^XLEN, and pushes the result to T.","pto_source_constraints":[]}] : 15..11=simm5 10..6=SrcL 5..0=6'b001100 ; SrcL simm5 ; -
C.AND [{"asm":"c.and srcL, srcR, ->t","group":"ALU","length_bits":16,"note":"C.AND snapshots two complete Reg5 sources, computes the bitwise conjunction of SrcL and SrcR, and pushes the wrapping XLEN result to T.","pto_source_constraints":[]}] : 15..11=SrcR 10..6=SrcL 5..0=6'b101000 ; SrcL SrcR ; -
C.CMP.EQI [{"asm":"c.cmp.eqi t#1, simm, ->t","group":"BRU","length_bits":16,"note":"C.CMP.EQI - Compare scalar operands and write the encoded boolean result.","pto_source_constraints":[]}] : 15..11=5'b00000 10..6=simm5 5..0=6'b101100 ; simm5 ; -
C.CMP.NEI [{"asm":"c.cmp.nei t#1, simm, ->t","group":"BRU","length_bits":16,"note":"C.CMP.NEI - Compare scalar operands and write the encoded boolean result.","pto_source_constraints":[]}] : 15..11=5'b00001 10..6=simm5 5..0=6'b101100 ; simm5 ; -
C.EBREAK [{"asm":"c.break imm","group":"SYS","length_bits":16,"note":"C.EBREAK raises software-breakpoint trap 50 with its 5-bit immediate as cause.","pto_source_constraints":[]}] : 15..11=5'b11000 10..6=imm5 5..0=6'b101100 ; imm5 ; -
C.LDI [{"asm":"c.ldi [srcL, simm], ->t","group":"LDA/BASE_IMM","length_bits":16,"note":"C.LDI snapshots its scalar sources, forms its encoded address, and loads one aligned little-endian 8-byte value.","pto_source_constraints":[]}] : 15..11=simm5 10..6=SrcL 5..0=6'b011010 ; SrcL simm5 ; -
C.LWI [{"asm":"c.lwi [srcL, simm], ->t","group":"LDA/BASE_IMM","length_bits":16,"note":"C.LWI snapshots its scalar sources, forms its encoded address, and loads one aligned little-endian 4-byte value.","pto_source_constraints":[]}] : 15..11=simm5 10..6=SrcL 5..0=6'b001010 ; SrcL simm5 ; -
C.MOVI [{"asm":"c.movi simm, ->{t, u, Rd}","group":"ALU","length_bits":16,"note":"C.MOVI sign-extends its encoded five-bit immediate to XLEN and publishes it through RegDst.","pto_source_constraints":[{"field":"RegDst","operator":"not-equal","value":10}]}] : 15..11=RegDst 10..6=simm5 5..0=6'b010110 ; RegDst simm5 ; -
C.MOVR [{"asm":"c.movr SrcL, ->{t, u, Rd}","group":"ALU","length_bits":16,"note":"C.MOVR snapshots a Reg5 source and publishes the complete XLEN value unchanged through RegDst.","pto_source_constraints":[]}] : 15..11=RegDst 10..6=SrcL 5..0=6'b000110 ; RegDst SrcL ; -
C.OR [{"asm":"c.or srcL, srcR, ->t","group":"ALU","length_bits":16,"note":"C.OR snapshots two complete Reg5 sources, computes the bitwise inclusive OR of SrcL and SrcR, and pushes the wrapping XLEN result to T.","pto_source_constraints":[]}] : 15..11=SrcR 10..6=SrcL 5..0=6'b111000 ; SrcL SrcR ; -
C.SDI [{"asm":"c.sdi t#1, [srcL, simm]","group":"STA/BASE_IMM","length_bits":16,"note":"C.SDI snapshots its scalar sources, forms its encoded address, and stores one aligned little-endian 8-byte value.","pto_source_constraints":[]}] : 15..11=simm5 10..6=SrcL 5..0=6'b111010 ; SrcL simm5 ; -
C.SETC.EQ [{"asm":"c.setc.eq srcL, srcR","group":"BRU","length_bits":16,"note":"C.SETC.EQ - Compare scalar operands and update the bundle commit condition.","pto_source_constraints":[]}] : 15..11=SrcR 10..6=SrcL 5..0=6'b100110 ; SrcL SrcR ; -
C.SETC.NE [{"asm":"c.setc.ne srcL, srcR","group":"BRU","length_bits":16,"note":"C.SETC.NE - Compare scalar operands and update the bundle commit condition.","pto_source_constraints":[]}] : 15..11=SrcR 10..6=SrcL 5..0=6'b110110 ; SrcL SrcR ; -
C.SETC.TGT [{"asm":"c.setc.tgt srcL","group":"ALU","length_bits":16,"note":"Snapshot one scalar source value into the active block BARG.BPCN.","pto_source_constraints":[]}] : 15..11=5'b00000 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.SETRET [{"asm":"c.setret uimm, ->ra","group":"ALU","length_bits":16,"note":"Materialize an unsigned halfword-scaled TPC-relative return address in ra and captured return state.","pto_source_constraints":[]}] : 15..11=5'b01010 10..6=uimm5 5..0=6'b010110 ; uimm5 ; -
C.SEXT.B [{"asm":"c.sext.b srcL, ->t","group":"ALU","length_bits":16,"note":"C.SEXT.B sign-extends SrcL[7:0] to XLEN and pushes the result to T.","pto_source_constraints":[]}] : 15..11=5'b01000 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.SEXT.H [{"asm":"c.sext.h srcL, ->t","group":"ALU","length_bits":16,"note":"C.SEXT.H sign-extends SrcL[15:0] to XLEN and pushes the result to T.","pto_source_constraints":[]}] : 15..11=5'b01001 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.SEXT.W [{"asm":"c.sext.w srcL, ->t","group":"ALU","length_bits":16,"note":"C.SEXT.W sign-extends SrcL[31:0] to XLEN and pushes the result to T.","pto_source_constraints":[]}] : 15..11=5'b01010 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.SLLI [{"asm":"c.slli t#1, uimm, ->t","group":"ALU","length_bits":16,"note":"C.SLLI snapshots the pre-instruction T#1 value, logically shifts it left by uimm5, and pushes the XLEN result to T.","pto_source_constraints":[]}] : 15..11=5'b00010 10..6=uimm5 5..0=6'b101100 ; uimm5 ; -
C.SRLI [{"asm":"c.srli t#1, uimm, ->t","group":"ALU","length_bits":16,"note":"C.SRLI snapshots the pre-instruction T#1 value, logically shifts it right by uimm5, and pushes the XLEN result to T.","pto_source_constraints":[]}] : 15..11=5'b00011 10..6=uimm5 5..0=6'b101100 ; uimm5 ; -
C.SSRGET [{"asm":"c.ssrget SSR-ID, ->t","group":"SYS","length_bits":16,"note":"C.SSRGET reads the complete encoded system-register address.","pto_source_constraints":[{"field":"SSRID","operator":"one-of","values":[0,1,16]}]}] : 15..11=5'b10000 10..6=SSRID 5..0=6'b101100 ; SSRID ; -
C.SUB [{"asm":"c.sub srcL, srcR, ->t","group":"ALU","length_bits":16,"note":"C.SUB snapshots two complete Reg5 sources, subtracts SrcR from SrcL modulo 2^XLEN, and pushes the result to T.","pto_source_constraints":[]}] : 15..11=SrcR 10..6=SrcL 5..0=6'b011000 ; SrcL SrcR ; -
C.SWI [{"asm":"c.swi t#1, [srcL, simm]","group":"STA/BASE_IMM","length_bits":16,"note":"C.SWI snapshots its scalar sources, forms its encoded address, and stores one aligned little-endian 4-byte value.","pto_source_constraints":[]}] : 15..11=simm5 10..6=SrcL 5..0=6'b101010 ; SrcL simm5 ; -
C.ZEXT.B [{"asm":"c.zext.b srcL, ->t","group":"ALU","length_bits":16,"note":"C.ZEXT.B zero-extends SrcL[7:0] to XLEN and pushes the result to T.","pto_source_constraints":[]}] : 15..11=5'b01011 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.ZEXT.H [{"asm":"c.zext.h srcL, ->t","group":"ALU","length_bits":16,"note":"C.ZEXT.H zero-extends SrcL[15:0] to XLEN and pushes the result to T.","pto_source_constraints":[]}] : 15..11=5'b01100 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.ZEXT.W [{"asm":"c.zext.w srcL, ->t","group":"ALU","length_bits":16,"note":"C.ZEXT.W zero-extends SrcL[31:0] to XLEN and pushes the result to T.","pto_source_constraints":[]}] : 15..11=5'b01101 10..6=SrcL 5..0=6'b011100 ; SrcL ; -
C.B.DIMI [{"asm":"C.B.DIMI imm, ->{LB0, LB1, LB2}","group":"Bundle Dimension","length_bits":16,"note":"Zero-extends imm8 and writes one selected bundle-local LB exactly once.","pto_source_constraints":[{"field":"LoopNest","operator":"not-equal","value":3}]}] : 15..14=LoopNest 13..6=imm8 5..0=6'b111100 ; LoopNest imm8 ; -
C.BSTART [{"asm":"C.BSTART COND,  label","group":"Bundle Split","length_bits":16,"note":"Starts a compressed standard block with a PC-relative direct or conditional candidate target.","pto_source_constraints":[]}] : 15..4=simm12 3..0=4'b0100 ; simm12 ; -
C.BSTART [{"asm":"C.BSTART DIRECT, label","group":"Bundle Split","length_bits":16,"note":"Starts a compressed standard block with a PC-relative direct or conditional candidate target.","pto_source_constraints":[]}] : 15..4=simm12 3..0=4'b0010 ; simm12 ; -
C.BSTART.FP [{"asm":"C.BSTART.FP {FALL, IND, RET}","group":"C.BSTART","length_bits":16,"note":"Starts a compressed FP block with fallthrough, indirect, or return transfer; every other BrType rejects before effects.","pto_source_constraints":[{"field":"BrType","operator":"one-of","values":[1,5,7]}]}] : 15..14=2'b00 13..11=BrType 10..0=11'b00010000000 ; BrType ; -
