# Canonical LinxISA v0.58 opcode source (consumed by tools/isa/build_golden.py)
#
# Format:
#   MNEMONIC [<json meta>] : <bit-assignments> [| <bit-assignments>] ; <operands> ; <constraints>
#
# Notes:
#   - If MNEMONIC contains spaces, it is written as a JSON string literal.
#   - Meta is a JSON object containing at least: {asm, group, length_bits}.
#   - Constraints apply to encoding part 0 and are written as tokens like Field!=0.

# Strict-v0.58 typed tile header contract:
# - Encoded selector families: TLSU, CUBE, TEPL; TLSU has only exact legal named forms.
# - Explicit named forms cover assigned TLSU/CUBE functions and every allocated TEPL selector.
# - TLOAD/TSTORE use B.DATR(layout/pad) + B.IOR(stride/base) + B.IOT.
# - CUBE matmul uses B.DIM LB0/LB1/LB2 as m/n/k; every result and every .ACC source is explicit.
# - VPAR/VSEQ are TVEC-equivalent SIMT headers with B.TEXT body; TLSU/CUBE/TEPL tile ops are header-driven.
# TLSU Functions 0..8 and 13 are direct TileOps, 9..12 and 14 are named Shared variants, and 15..31 are reserved.
BSTART.VPAR [{"asm":"BSTART.VPAR <VS8, VS16>","group":"Block Split","length_bits":32,"note":"TVEC-equivalent parallel SIMT header; requires B.TEXT body target in decoupled form."}] : 31..27=5'b0_0000 26..25=Mode 24..20=5'b0_0000 19..15=5'b0_0100 14..12=3'b001 11..7=5'b0_0011 6..4=3'b000 3..1=3'b000 0=1 ; Mode ; -
BSTART.VSEQ [{"asm":"BSTART.VSEQ <VS8, VS16>","group":"Block Split","length_bits":32,"note":"TVEC-equivalent sequential SIMT header; requires B.TEXT body target in decoupled form."}] : 31..27=5'b0_0000 26..25=Mode 24..20=5'b0_0000 19..15=5'b0_0101 14..12=3'b001 11..7=5'b0_0011 6..4=3'b000 3..1=3'b000 0=1 ; Mode ; -

B.TEXT [{"asm":"B.TEXT <label>","group":"Bundle Offset","length_bits":32,"note":"Sets the out-of-line body entry address for a decoupled bundle.","pto_source_constraints":[]}] : 31..7=simm25 6..0=7'b0000011 ; simm25 ; -
BSTART.MPAR [{"asm":"BSTART.MPAR <VS8, VS16>","group":"Bundle Split","length_bits":32,"note":"Closes the current bundle, initializes the next bundle descriptor, and selects its transfer and execution kind.","pto_source_constraints":[]}] : 31..27=5'b00000 26..25=Mode 24..0=25'b0000000000001000110000001 ; Mode ; -
BSTART.MSEQ [{"asm":"BSTART.MSEQ <VS8, VS16>","group":"Bundle Split","length_bits":32,"note":"Closes the current bundle, initializes the next bundle descriptor, and selects its transfer and execution kind.","pto_source_constraints":[]}] : 31..27=5'b00000 26..25=Mode 24..0=25'b0000000001001000110000001 ; Mode ; -

