    let srcl : bits(10) = part0[19..15] @ part1[19..15];
    let srcr : bits(10) = part0[24..20] @ part1[24..20];
    let simm24 : bits(24) = part0[11..7] @ part0[31..25] @ part1[11..7] @ part1[31..25];
    decoded_vec_srcl_type_shadow = 0b00001;
    decoded_vec_srcr_type_shadow = 0b00001;
    decoded_vec_srca_type_shadow = 0b00001;
    decoded_vec_srcp_type_shadow = 0b00001;
    decoded_vec_dst_type_shadow = 0b00001;
    set_decoded_vec_regids(srcl, srcr, 0b00_0000_0000, 0b00_0000_0000, 0b00_0000_0000);
    exec_v_swi_u_brg(decode_vec_reg_selector(srcl), srcr[4..0], simm24, l)
  }
  else {
    trap_illegal_inst(read_pc_or_tpc())
  }
}
