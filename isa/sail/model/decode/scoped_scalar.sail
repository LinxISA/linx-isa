function pto_scoped_inner_16(inst : bits(16)) -> bits(8) = {
  if pto_scoped_match_0(inst) then 0x00
  else if pto_scoped_match_1(inst) then 0x01
  else if pto_scoped_match_2(inst) then 0x02
  else if pto_scoped_match_3(inst) then 0x03
  else 0xFF
}

